[Unit]
Description=reFrame Wi-Fi provisioning service
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/libexec/reframe-network
Restart=on-failure
RestartSec=5

# The service needs NetworkManager control in order to replace the temporary
# access point with the network selected in the setup page.
User=root
Group=root

[Install]
WantedBy=multi-user.target
