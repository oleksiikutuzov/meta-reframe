From 881fc3eb9238bcaa3f5c6a3b602b749307e1ffa6 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sat, 29 Aug 2026 22:04:00 +0000
Subject: [PATCH] capture: save images atomically

Write capture outputs through synced temporary files and atomically rename them
only after encoding succeeds. Track save threads so graceful service and
timeout shutdowns wait for pending writes.

Upstream-Status: Pending
---
 reframe.py | 94 +++++++++++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 82 insertions(+), 12 deletions(-)

diff --git a/reframe.py b/reframe.py
index a81952c..57e1e11 100644
--- a/reframe.py
+++ b/reframe.py
@@ -5,6 +5,7 @@ import sys
 import json
 import subprocess
 import logging
