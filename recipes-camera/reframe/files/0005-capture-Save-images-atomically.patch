 import socket
 from time import sleep
 
@@ -91,6 +92,34 @@ DISPLAY_IMAGE_SIZE = (DISPLAY_IMAGE_WIDTH, DISPLAY_IMAGE_HEIGHT)
 DISPLAY_PANEL_SIZE = (DISPLAY_PANEL_WIDTH, DISPLAY_PANEL_HEIGHT)
 BUTTON_POLL_INTERVAL_SECONDS = 0.025
 
+
+def _save_image_atomically(image, final_path, image_format):
+    """Encode and sync an image before making its final path visible."""
+    folder = os.path.dirname(final_path)
+    basename = os.path.basename(final_path)
+    temporary_path = os.path.join(
+        folder,
+        f".{basename}.{os.getpid()}.{threading.get_ident()}.tmp"
+    )
+    try:
+        with open(temporary_path, "wb") as output:
+            image.save(output, format=image_format)
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(temporary_path, final_path)
+
+        directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
+        directory_fd = os.open(folder, directory_flags)
+        try:
+            os.fsync(directory_fd)
+        finally:
+            os.close(directory_fd)
+    finally:
+        try:
+            os.unlink(temporary_path)
+        except FileNotFoundError:
+            pass
+
 # Color palettes for dithering. We blend between the two to create a saturated look while preserving details.
 # Idea from https://github.com/pimoroni/inky
 DESATURATED_PALETTE = [
@@ -1267,11 +1296,54 @@ class CameraSystem:
         self.timeout_running = False
         self._timeout_started = False
         self._timeout_stop_event = threading.Event()
+        self._save_threads = set()
+        self._save_threads_lock = threading.Lock()
         self.dashboard_qr_thread = None
         self._dashboard_qr_monitor_started = False
         self.dashboard_qr_running = False
         logging.info("Timeout monitor initialization deferred for fast startup")
 
+    def _start_output_save(self, original_image, photo_path,
+                           dithered_image, dithered_path, result):
+        """Save capture outputs in a tracked background thread."""
+        def _save_outputs():
+            try:
+                _save_image_atomically(original_image, photo_path, "JPEG")
+                result["file_size"] = os.path.getsize(photo_path)
+                logging.info(f"Original JPEG saved: {photo_path}")
+                _save_image_atomically(dithered_image, dithered_path, "PNG")
+                logging.info(f"Dithered PNG saved: {dithered_path}")
+            except Exception as e:
+                logging.error(f"Error saving photo outputs: {e}")
+            finally:
+                with self._save_threads_lock:
+                    self._save_threads.discard(threading.current_thread())
+
+        save_thread = threading.Thread(target=_save_outputs, daemon=True)
+        with self._save_threads_lock:
+            self._save_threads.add(save_thread)
+        try:
+            save_thread.start()
+        except Exception:
+            with self._save_threads_lock:
+                self._save_threads.discard(save_thread)
+            raise
+
+    def wait_for_pending_saves(self, timeout=10):
+        """Wait for output files to finish without blocking indefinitely."""
+        deadline = time.monotonic() + timeout
+        while True:
+            with self._save_threads_lock:
+                pending = list(self._save_threads)
+            if not pending:
+                return True
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                logging.error("Timed out waiting for %d photo save(s)", len(pending))
+                return False
+            for save_thread in pending:
+                save_thread.join(timeout=remaining)
+
     def start_timeout_monitor(self):
         """Start the background timeout monitoring thread."""
         if not self._timeout_started and self.camera_manager.is_timeout_enabled():
@@ -1308,6 +1380,7 @@ class CameraSystem:
             try:
                 if self.camera_manager.is_timeout_exceeded():
                     logging.info("Timeout exceeded, initiating system shutdown")
+                    self.wait_for_pending_saves()
                     self.camera_manager.shutdown_system()
                     # If we reach here, shutdown failed, so stop monitoring
                     break
