[Unit]
Description=reFrame camera capture service
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=notify
NotifyAccess=main
User=reframe
Group=reframe
SupplementaryGroups=video i2c
WorkingDirectory=/var/lib/reframe
Environment=REFRAME_APP_PATH=/usr/lib/reframe
Environment=REFRAME_DATA_PATH=/var/lib/reframe
ExecStart=/usr/bin/python3 /usr/lib/reframe/reframe.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
